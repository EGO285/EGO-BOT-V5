# Copie ce fichier en ".env" et remplis les valeurs.

# --- Connexion WhatsApp ---
# USE_QR_CODE=true  -> QR code à scanner, servi en image via /qr?token=... sur le serveur HTTP du bot
# USE_QR_CODE=false (défaut) -> code de jumelage (pairing code) affiché dans les logs
USE_QR_CODE=true

# Numéro WhatsApp du bot (sans le +), utilisé uniquement en mode pairing code
PHONE_NUMBER=22361872227

# Jeton secret protégeant l'URL du QR (voir /qr?token=...). Fixe une valeur stable ici,
# sinon un secret aléatoire est régénéré à chaque démarrage (visible dans les logs).
QR_SECRET=

# --- Stockage des fiches joueurs (Upstash Redis) ---
# Récupère ces deux valeurs dans ta base Upstash Redis : onglet "REST API".
UPSTASH_REDIS_REST_URL=https://romantic-perch-134129.upstash.io
UPSTASH_REDIS_REST_TOKEN=gQAAAAAAAgvxAAIgcDJlNjczMmM5YTI4ZTA0ZTMzYmY4MGI5YjhjYjBlZjRlZQ

# --- Serveur HTTP (healthcheck + page QR) ---
PORT=3000
