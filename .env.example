# ============================================================
#  E.V.O — EGO VIRTUAL OPERATOR
#  Copie ce fichier en ".env" et remplis TES propres valeurs.
# ============================================================

# --- Connexion WhatsApp ---
# USE_QR_CODE=true  -> QR code à scanner, servi en image via /qr?token=... sur le serveur HTTP
# USE_QR_CODE=false -> code de jumelage (PAIRING CODE) affiché dans les logs (recommandé)
USE_QR_CODE=false

# Numéro WhatsApp du bot (format international SANS le +),
# utilisé uniquement en mode pairing code. Exemple : 33612345678
PHONE_NUMBER=

# Jeton secret protégeant l'URL du QR (voir /qr?token=...). Mets une valeur stable ici,
# sinon un secret aléatoire est régénéré à chaque démarrage (visible dans les logs).
QR_SECRET=

# --- Stockage des fiches joueurs (TA base Upstash Redis) ---
# Récupère ces deux valeurs dans TON tableau de bord Upstash Redis, onglet "REST API".
# ⚠️ Ne partage jamais ton token publiquement (ne le commit pas sur GitHub).
UPSTASH_REDIS_REST_URL=https://ton-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=colle-ici-ton-token-rest-upstash

# --- Serveur HTTP (healthcheck + page QR) ---
PORT=3000
