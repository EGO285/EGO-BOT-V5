# ============================================================
#  E.V.O — EGO VIRTUAL OPERATOR
#  Copie ce fichier en ".env" et remplis TES propres valeurs.
# ============================================================

# --- Connexion WhatsApp ---
# USE_QR_CODE=true  -> QR code à scanner, servi en image via /qr?token=... sur le serveur HTTP
# USE_QR_CODE=true -> code de jumelage (PAIRING CODE) affiché dans les logs (recommandé)
USE_QR_CODE=true

# Numéro WhatsApp du bot (format international SANS le +),
# utilisé uniquement en mode pairing code. Exemple : 33612345678
PHONE_NUMBER=

# Jeton secret protégeant l'URL du QR (voir /qr?token=...). Mets une valeur stable ici,
# sinon un secret aléatoire est régénéré à chaque démarrage (visible dans les logs).
QR_SECRET=

# --- Stockage des fiches joueurs (TA base Upstash Redis) ---
# Récupère ces deux valeurs dans TON tableau de bord Upstash Redis, onglet "REST API".
# ⚠️ Ne partage jamais ton token publiquement (ne le commit pas sur GitHub).
UPSTASH_REDIS_REST_URL=https://ton-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=colle-ici-ton-token-rest-upstash

# --- Serveur HTTP (healthcheck + page QR) ---
PORT=3000

# --- Cerveau IA de la commande !evo (multi-fournisseurs) ---
# Choisis TON fournisseur avec AI_PROVIDER : hf | openrouter | groq | gemini | custom
# Chacun a un tier GRATUIT (texte ET vision) sauf HF quand tes crédits sont épuisés.
#
#   RECOMMANDÉ si HF est à sec :  AI_PROVIDER=openrouter   ou   AI_PROVIDER=gemini
#   -> texte + vision gratuits, une seule clé.
#
AI_PROVIDER=hf

# Clé du fournisseur choisi (mets SEULEMENT celle qui correspond) :
HF_TOKEN=              # si AI_PROVIDER=hf   -> https://huggingface.co/settings/tokens
OPENROUTER_KEY=       # si AI_PROVIDER=openrouter -> https://openrouter.ai/keys  (modèles :free)
GEMINI_KEY=           # si AI_PROVIDER=gemini     -> https://aistudio.google.com/apikey
GROQ_KEY=             # si AI_PROVIDER=groq       -> https://console.groq.com/keys

# (optionnel) Forcer un modèle précis. Si vide, un bon défaut est choisi selon le fournisseur.
#   openrouter texte  : meta-llama/llama-3.3-70b-instruct:free
#   openrouter vision : meta-llama/llama-3.2-11b-vision-instruct:free
#   gemini (texte+vision d'un coup) : gemini-2.0-flash
HF_MODEL=
HF_VISION_MODEL=

# (optionnel) Fournisseur "custom" compatible OpenAI :
# AI_BASE_URL=https://.../v1/chat/completions
# AI_KEY=...

# (optionnel) Mémoire de conversation de !evo, stockée dans TON Upstash.
# Nombre d'échanges (question+réponse) gardés par conversation :
EVO_MAX_TOURS=12
# Durée de vie de l'historique, en jours (au-delà, il s'efface tout seul) :
EVO_HIST_TTL=30

# --- Accès internet de E.V.O (recherche web) ---
# Clé GRATUITE sur https://app.tavily.com (onglet API Keys).
# Sans clé, !evo peut quand même LIRE un lien qu'on lui donne, mais ne fait pas de recherche web.
TAVILY_API_KEY=
